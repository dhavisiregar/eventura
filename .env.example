# Copy this file to .env at the project root. docker-compose reads it
# automatically and fans these values out to the mysql/backend/frontend
# services (see docker-compose.yml).

DB_PASSWORD=password
DB_NAME=event_management

# Use the SAME secret for both the backend (signs tokens) and the frontend
# (verifies them in its route-protection proxy).
JWT_SECRET=change-this-to-a-long-random-string

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_UPLOADS_URL=http://localhost:8080

# Sandbox keys from https://dashboard.sandbox.midtrans.com/settings/config_info
# Paid-event checkout will fail without these set.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
