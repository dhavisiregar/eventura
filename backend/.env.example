# Copy this file to .env for local (non-Docker) development.
# When running via docker-compose, these are instead supplied as
# environment variables in docker-compose.yml.

APP_ENV=development
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=event_management
# Set to true for managed hosts that require TLS (e.g. Aiven).
DB_SSL=false
# Only needed if DB_SSL=true and the host signs with a private CA (e.g. Aiven) rather
# than a publicly-trusted one — paste the PEM cert content (not a file path) here.
DB_SSL_CA=

# Must match the frontend's JWT_SECRET exactly — both sides verify the same token.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRY_HOURS=72

FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
PAYMENT_DEADLINE_MINUTES=120

# Get sandbox keys from https://dashboard.sandbox.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
